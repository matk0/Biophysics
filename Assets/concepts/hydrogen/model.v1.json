  "qcschema_scope": "The molecular record identifies the nucleus, charge and multiplicity. The analytical electronic state is specified here; it is not determined by charge and multiplicity.",
  "coordinates": {"unit": "bohr", "handedness": "right", "orbital_axis": "z"},
  "density_unit": "bohr^-3",
  "density_meaning": "Probability per unit volume for one electron; integral over all space equals one.",
  "constants": {
    "edition": "CODATA 2022",
    "bohr_m": 5.29177210544e-11,
    "bohr_m_standard_uncertainty": 8.2e-21,
