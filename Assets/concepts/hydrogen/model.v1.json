    "probability": 0.9,
    "remaining_probability": 0.1,
    "profile_intervals": 128,
    "azimuth_segments": 128,
    "analytical_probability_tolerance": 1e-10,
    "mesh_probability_tolerance": 0.001,
    "quadrature_tolerance": 1e-5,
    "finite_domain_normalization": false
  },
  "presentation": {
    "color_linear_rgb": [0.12, 0.45, 0.72],
    "color_meaning": "Illustrative; both lobes represent nonnegative probability density",
    "opacity": 1.0,
    "roughness": 0.32,
    "usd_unit": "angstrom",
    "usd_meters_per_unit": 1e-10,
    "usd_up_axis": "Z",
    "gltf_unit": "meter",
    "gltf_up_axis": "Y",
    "gltf_axis_mapping": ["x", "z", "-y"]
  },
  "sources": [
    {"title": "Hydrogen wavefunctions, Table 3.3, printed page 74", "url": "https://www.columbia.edu/~jcc2161/documents/IQM.pdf#page=82"},
