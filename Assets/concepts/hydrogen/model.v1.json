  "title": "Hydrogen stationary electron probability density",
  "atom": "atom.qcschema.json",
  "atom_identifier": "urn:biophysics:atom:protium:neutral",
  "assumptions": [
    "Isolated neutral protium with one electron",
    "Fixed point proton at the coordinate origin",
    "Nonrelativistic Coulomb Hamiltonian",
    "No applied field; spin-dependent and radiative effects omitted"
